{
  "name": "try-tenants",
  "dockerComposeFile": "compose.yaml",
  "service": "dev",
  "runServices": ["dev", "sqlserver", "otel-dashboard", "mailpit"],
  "workspaceFolder": "/workspaces/try-tenants",
  "remoteUser": "vscode",
  "forwardPorts": [5173, 5000],
  "portsAttributes": {
    "5173": { "label": "SvelteKit" },
    "5000": { "label": "ASP.NET Core" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "svelte.svelte-vscode",
        "ms-dotnettools.csdevkit",
        "esbenp.prettier-vscode",
        "anthropic.claude-code"
      ]
    }
  },
  "shutdownAction": "stopCompose",
  "postCreateCommand": "mise trust /workspaces/try-tenants/mise.toml",
  "remoteEnv": {
    "LANG": "ja_JP.UTF-8"
  }
}
