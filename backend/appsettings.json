{
  // ログレベルはこのファイルと appsettings.{環境名}.json で管理し、コードの AddFilter では指定しない(decisions/0004)。
  // 運用中は環境変数(例: Logging__LogLevel__Microsoft.EntityFrameworkCore.Database.Command=Information)で再配備せずに上書きできる。
  // ここで出力対象になったログは、OpenTelemetry 有効時に OTLP でも送信される。
  "Logging": {
    "LogLevel": {
      // 個別に指定していないカテゴリーの最低レベル。アプリ自身のログはここに従う。
      "Default": "Information",
      // ASP.NET Core はリクエストごとに Information のログを出し量が多い。受信リクエストはトレースで追えるため警告以上に絞る。
      "Microsoft.AspNetCore": "Warning",
      // EF Core が実行した SQL 文のログ(Executed DbCommand)。クエリごとに出力され量が多いため、既定では警告以上に絞る。
      // 開発環境では appsettings.Development.json で Information にして SQL を確認できるようにしている。
      // パラメーター値は EnableSensitiveDataLogging を使わない限り "?" で伏せられる。
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
